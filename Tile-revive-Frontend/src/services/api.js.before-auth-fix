// ======================================================
// APPROVE USER
// ======================================================

export async function approveUser(userId) {
    if (
        userId === undefined ||
        userId === null ||
        String(userId).trim() === ""
    ) {
        throw new Error(
            "Invalid user ID."
        );
    }

    return request(
        `/admin/users/${encodeURIComponent(
            String(userId).trim()
        )}/approve`,
        {
            method: "PATCH",
        }
    );
}

// ======================================================
// ADMIN REPORTS
// ======================================================

export async function getAdminReports(period = "30D") {
    const query = new URLSearchParams({
        period,
    });

    return request(
        `/admin/reports?${query.toString()}`,
        {
            method: "GET",
        }
    );
}

