/* ============================================================
   TILE REVIVE — ADMIN REPORTS
   PREMIUM BLACK BUSINESS INTELLIGENCE UI
   ============================================================ */

:root {
    --reports-bg: #050505;
    --reports-surface: #0b0b0b;
    --reports-surface-2: #101010;
    --reports-surface-3: #151515;
    --reports-border: rgba(255,255,255,.09);
    --reports-border-strong: rgba(255,255,255,.15);

    --reports-white: #ffffff;
    --reports-text: #f4f4f4;
    --reports-muted: #8b8b8b;
    --reports-dim: #5d5d5d;

    --reports-green: #32e875;
    --reports-green-soft: rgba(50,232,117,.10);
    --reports-red: #ff4d5a;
    --reports-red-soft: rgba(255,77,90,.10);

    --reports-shadow:
        0 30px 80px rgba(0,0,0,.45);

    --reports-radius: 20px;
}

/* ============================================================
   RESET / BASE
   ============================================================ */

.admin-reports,
.admin-reports * {
    box-sizing: border-box;
}

.admin-reports {
    min-height: 100vh;
    width: 100%;
    background:
        radial-gradient(
            circle at 80% 0%,
            rgba(255,255,255,.045),
            transparent 30%
        ),
        radial-gradient(
            circle at 10% 30%,
            rgba(255,255,255,.025),
            transparent 25%
        ),
        var(--reports-bg);

    color: var(--reports-text);
    font-family:
        Inter,
        ui-sans-serif,
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;

    overflow-x: hidden;
}

.admin-reports button {
    font: inherit;
}

.admin-reports button:focus-visible {
    outline: 2px solid var(--reports-green);
    outline-offset: 3px;
}

/* ============================================================
   LOADING
   ============================================================ */

.admin-reports-loading {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 22px;
    background: #050505;
    color: white;
}

.reports-loading-orbit {
    width: 64px;
    height: 64px;
    border: 1px solid rgba(255,255,255,.12);
    border-top-color: white;
    border-radius: 50%;
    animation: reportsSpin 1s linear infinite;
    position: relative;
}

.reports-loading-orbit span {
    position: absolute;
    width: 8px;
    height: 8px;
    background: var(--reports-green);
    border-radius: 50%;
    top: 5px;
    left: 50%;
    transform: translateX(-50%);
    box-shadow: 0 0 20px var(--reports-green);
}

.reports-loading-copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 5px;
}

.reports-loading-copy strong {
    font-size: 15px;
    letter-spacing: .08em;
    text-transform: uppercase;
}

.reports-loading-copy span {
    color: var(--reports-muted);
    font-size: 13px;
}

@keyframes reportsSpin {
    to {
        transform: rotate(360deg);
    }
}

/* ============================================================
   TOP BAR
   ============================================================ */

.reports-topbar {
    width: min(1440px, calc(100% - 48px));
    margin: 0 auto;
    min-height: 84px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    border-bottom: 1px solid var(--reports-border);
}

.reports-brand {
    display: flex;
    align-items: center;
    gap: 13px;
}

.reports-brand-mark {
    width: 42px;
    height: 42px;
    display: grid;
    place-items: center;

    border: 1px solid rgba(255,255,255,.22);
    background: #111;
    color: white;

    font-size: 13px;
    font-weight: 800;
    letter-spacing: -.05em;
}

.reports-brand > div:last-child {
    display: flex;
    flex-direction: column;
    gap: 3px;
}

.reports-brand span {
    font-size: 13px;
    font-weight: 800;
    letter-spacing: .18em;
}

.reports-brand small {
    color: var(--reports-dim);
    font-size: 8px;
    font-weight: 700;
    letter-spacing: .18em;
}

.reports-topbar-actions {
    display: flex;
    align-items: center;
    gap: 10px;
}

.reports-live-status {
    min-height: 36px;
    display: flex;
    align-items: center;
    gap: 8px;

    padding: 0 13px;
    border: 1px solid var(--reports-border);
    background: rgba(255,255,255,.025);

    font-size: 10px;
    font-weight: 800;
    letter-spacing: .1em;
    text-transform: uppercase;
}

.reports-live-status.live {
    color: var(--reports-green);
    border-color: rgba(50,232,117,.22);
    background: var(--reports-green-soft);
}

.reports-live-status.monitoring {
    color: #aaa;
}

.reports-live-status.warning {
    color: #ffbd4a;
}

.reports-live-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: currentColor;
}

.reports-live-status.live .reports-live-dot {
    box-shadow: 0 0 0 4px rgba(50,232,117,.08);
    animation: livePulse 1.5s infinite;
}

@keyframes livePulse {
    0%,100% {
        opacity: 1;
        box-shadow: 0 0 0 3px rgba(50,232,117,.08);
    }

    50% {
        opacity: .45;
        box-shadow: 0 0 0 8px rgba(50,232,117,0);
    }
}

.reports-back-button,
.reports-refresh-button {
    height: 38px;
    padding: 0 14px;

    display: inline-flex;
    align-items: center;
    gap: 8px;

    color: #ddd;
    background: #0d0d0d;
    border: 1px solid var(--reports-border);

    cursor: pointer;
    transition:
        background .2s ease,
        border-color .2s ease,
        transform .2s ease;
}

.reports-back-button:hover,
.reports-refresh-button:hover {
    background: #171717;
    border-color: var(--reports-border-strong);
    transform: translateY(-1px);
}

.reports-refresh-button:disabled {
    opacity: .55;
    cursor: wait;
}

.refresh-icon {
    font-size: 17px;
}

.refresh-icon.spinning {
    animation: reportsSpin .8s linear infinite;
}

/* ============================================================
   HERO
   ============================================================ */

.reports-hero {
    width: min(1440px, calc(100% - 48px));
    margin: 0 auto;

    min-height: 350px;

    display: flex;
    align-items: flex-end;
    justify-content: space-between;

    padding: 90px 0 70px;
    position: relative;
}

.reports-hero::before {
    content: "";
    position: absolute;
    left: -15%;
    right: -15%;
    bottom: 0;
    height: 1px;
    background: linear-gradient(
        90deg,
        transparent,
        rgba(255,255,255,.13),
        transparent
    );
}

.reports-hero-copy {
    max-width: 850px;
}

.reports-kicker {
    display: flex;
    align-items: center;
    gap: 10px;

    margin-bottom: 25px;

    color: var(--reports-muted);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: .18em;
}

.reports-kicker span {
    width: 28px;
    height: 1px;
    background: white;
}

.reports-hero h1 {
    margin: 0;

    font-size: clamp(56px, 8vw, 118px);
    line-height: .88;
    letter-spacing: -.075em;
    font-weight: 800;
}

.reports-hero h1 span {
    display: inline-block;
    margin: 0 14px;
    color: #4b4b4b;
    font-weight: 300;
}

.reports-hero p {
    max-width: 620px;
    margin: 30px 0 0;

    color: var(--reports-muted);
    font-size: 15px;
    line-height: 1.8;
}

.reports-hero-meta {
    min-width: 180px;
    padding-bottom: 5px;

    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 5px;

    text-align: right;
}

.hero-meta-line {
    width: 55px;
    height: 2px;
    background: white;
    margin-bottom: 8px;
}

.reports-hero-meta span {
    color: var(--reports-dim);
    font-size: 9px;
    font-weight: 800;
    letter-spacing: .16em;
}

.reports-hero-meta strong {
    font-size: 42px;
    line-height: 1;
    letter-spacing: -.06em;
}

.reports-hero-meta small {
    color: var(--reports-muted);
    font-size: 11px;
}

/* ============================================================
   ERROR
   ============================================================ */

.reports-error {
    width: min(1440px, calc(100% - 48px));
    margin: 30px auto 0;

    padding: 16px 18px;

    display: flex;
    align-items: center;
    gap: 14px;

    border: 1px solid rgba(255,190,70,.2);
    background: rgba(255,190,70,.05);
}

.reports-error-icon {
    width: 34px;
    height: 34px;

    display: grid;
    place-items: center;

    border: 1px solid rgba(255,190,70,.3);
    color: #ffbd4a;
    font-weight: 800;
}

.reports-error-copy {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.reports-error-copy strong {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: .08em;
}

.reports-error-copy span {
    color: var(--reports-muted);
    font-size: 12px;
}

.reports-error button {
    border: 1px solid rgba(255,255,255,.14);
    background: #111;
    color: white;
    padding: 9px 13px;
    cursor: pointer;
}

/* ============================================================
   GENERAL SECTION
   ============================================================ */

.reports-section,
.reports-live-panel {
    width: min(1440px, calc(100% - 48px));
    margin: 0 auto;
}

.reports-section {
    padding: 90px 0;
    border-bottom: 1px solid var(--reports-border);
}

.section-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 30px;
    margin-bottom: 40px;
}

.section-index {
    margin-bottom: 12px;

    color: var(--reports-dim);
    font-size: 9px;
    font-weight: 800;
    letter-spacing: .18em;
}

.section-heading h2 {
    margin: 0;
    font-size: clamp(28px, 4vw, 48px);
    line-height: 1;
    letter-spacing: -.055em;
}

.section-heading p {
    margin: 13px 0 0;
    color: var(--reports-muted);
    font-size: 13px;
    line-height: 1.6;
}

.section-heading-note,
.integration-status {
    padding: 8px 11px;
    border: 1px solid var(--reports-border);

    color: var(--reports-dim);
    font-size: 9px;
    font-weight: 800;
    letter-spacing: .12em;
}

/* ============================================================
   LIVE PANEL
   ============================================================ */

.reports-live-panel {
    padding: 70px 0;
    border-bottom: 1px solid var(--reports-border);
}

.live-panel-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 30px;
    margin-bottom: 35px;
}

.live-panel-heading h2 {
    margin: 0;
    font-size: clamp(28px, 4vw, 46px);
    letter-spacing: -.055em;
}

.live-panel-heading p {
    margin: 10px 0 0;
    color: var(--reports-muted);
    font-size: 13px;
}

.live-indicator {
    display: flex;
    align-items: center;
    gap: 12px;

    padding: 12px 15px;
    border: 1px solid var(--reports-border);
    background: #0b0b0b;
}

.live-indicator-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--reports-dim);
}

.live-indicator.active {
    border-color: rgba(50,232,117,.2);
    background: rgba(50,232,117,.045);
}

.live-indicator.active .live-indicator-dot {
    background: var(--reports-green);
    box-shadow: 0 0 0 5px rgba(50,232,117,.08);
    animation: livePulse 1.4s infinite;
}

.live-indicator.inactive .live-indicator-dot {
    background: var(--reports-red);
    animation: redPulse 1.5s infinite;
}

@keyframes redPulse {
    0%,100% {
        opacity: 1;
        box-shadow: 0 0 0 3px rgba(255,77,90,.08);
    }

    50% {
        opacity: .45;
        box-shadow: 0 0 0 8px rgba(255,77,90,0);
    }
}

.live-indicator div {
    display: flex;
    flex-direction: column;
    gap: 3px;
}

.live-indicator strong {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: .06em;
}

.live-indicator small {
    color: var(--reports-muted);
    font-size: 10px;
}

.live-metrics {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr 1.4fr;
    border: 1px solid var(--reports-border);
    background: var(--reports-surface);
}

.live-metric {
    min-height: 175px;
    padding: 27px;

    display: flex;
    flex-direction: column;
    justify-content: center;

    border-right: 1px solid var(--reports-border);
}

.live-metric span {
    color: var(--reports-dim);
    font-size: 9px;
    font-weight: 800;
    letter-spacing: .14em;
}

.live-metric strong {
    margin-top: 13px;
    font-size: 45px;
    line-height: 1;
    letter-spacing: -.065em;
}

.live-metric small {
    margin-top: 8px;
    color: var(--reports-muted);
    font-size: 11px;
}

.live-metric.primary strong {
    color: var(--reports-green);
}

.live-visual {
    min-height: 175px;
    padding: 27px;

    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 25px;

    background:
        linear-gradient(
            135deg,
            rgba(255,255,255,.035),
            transparent
        );
}

.live-wave {
    height: 65px;

    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
}

.live-wave span {
    width: 100%;
    height: 20%;
    background: #333;
    position: relative;
}

.live-wave span:nth-child(2) { height: 45%; }
.live-wave span:nth-child(3) { height: 30%; }
.live-wave span:nth-child(4) { height: 70%; }
.live-wave span:nth-child(5) { height: 48%; }
.live-wave span:nth-child(6) { height: 90%; }
.live-wave span:nth-child(7) { height: 58%; }
.live-wave span:nth-child(8) { height: 78%; }
.live-wave span:nth-child(9) { height: 42%; }
.live-wave span:nth-child(10) { height: 68%; }
.live-wave span:nth-child(11) { height: 35%; }
.live-wave span:nth-child(12) { height: 55%; }

.live-wave span:nth-child(6),
.live-wave span:nth-child(8) {
    background: var(--reports-green);
    box-shadow: 0 0 18px rgba(50,232,117,.18);
}

.live-visual small {
    color: var(--reports-dim);
    font-size: 8px;
    font-weight: 800;
    letter-spacing: .16em;
}

/* ============================================================
   FINANCIAL CARDS
   ============================================================ */

.financial-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
}

.financial-card {
    min-height: 235px;

    padding: 24px;

    display: flex;
    flex-direction: column;

    background:
        linear-gradient(
            145deg,
            rgba(255,255,255,.045),
            rgba(255,255,255,.012)
        );

    border: 1px solid var(--reports-border);

    transition:
        transform .25s ease,
        border-color .25s ease,
        background .25s ease;
}

.financial-card:hover {
    transform: translateY(-4px);
    border-color: rgba(255,255,255,.18);
    background: #111;
}

.financial-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.financial-card-top span {
    color: var(--reports-muted);
    font-size: 9px;
    font-weight: 800;
    letter-spacing: .13em;
}

.financial-card-top i {
    width: 28px;
    height: 28px;

    display: grid;
    place-items: center;

    border: 1px solid var(--reports-border);
    color: #aaa;

    font-size: 10px;
    font-style: normal;
}

.financial-card > strong {
    margin-top: auto;

    font-size: clamp(28px, 3vw, 42px);
    line-height: 1;
    letter-spacing: -.06em;
}

.revenue-card > strong,
.profit-card > strong {
    color: white;
}

.expenditure-card > strong {
    color: #ddd;
}

.profit-card {
    border-color: rgba(50,232,117,.15);
    background:
        linear-gradient(
            145deg,
            rgba(50,232,117,.08),
            rgba(255,255,255,.015)
        );
}

.profit-card > strong {
    color: var(--reports-green);
}

.financial-card-bottom {
    margin-top: 16px;
    padding-top: 13px;

    border-top: 1px solid var(--reports-border);

    color: var(--reports-dim);
    font-size: 10px;
}

.secondary-metrics {
    margin-top: 10px;

    display: grid;
    grid-template-columns: repeat(3, 1fr);

    border: 1px solid var(--reports-border);
    background: #090909;
}

.secondary-metrics > div {
    padding: 20px 23px;
    border-right: 1px solid var(--reports-border);

    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
}

.secondary-metrics > div:last-child {
    border-right: 0;
}

.secondary-metrics span {
    color: var(--reports-dim);
    font-size: 9px;
    font-weight: 800;
    letter-spacing: .1em;
}

.secondary-metrics strong {
    font-size: 16px;
}

/* ============================================================
   CUSTOMER JOURNEY
   ============================================================ */

.journey-section {
    position: relative;
}

.journey-total {
    min-width: 100px;

    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 3px;
}

.journey-total span {
    color: var(--reports-dim);
    font-size: 8px;
    font-weight: 800;
    letter-spacing: .14em;
}

.journey-total strong {
    font-size: 34px;
    letter-spacing: -.06em;
}

.journey-chart {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.journey-row {
    min-height: 75px;

    display: grid;
    grid-template-columns: 45px 180px 1fr 80px;
    align-items: center;
    gap: 18px;

    padding: 12px 18px;

    border: 1px solid var(--reports-border);
    background: #0a0a0a;

    transition:
        border-color .2s ease,
        background .2s ease;
}

.journey-row:hover {
    background: #101010;
    border-color: rgba(255,255,255,.15);
}

.journey-number {
    color: #444;
    font-size: 10px;
    font-weight: 800;
}

.journey-label {
    display: flex;
    flex-direction: column;
    gap: 3px;
}

.journey-label strong {
    font-size: 12px;
}

.journey-label span {
    color: var(--reports-dim);
    font-size: 9px;
}

.journey-bar-track {
    height: 8px;
    background: #191919;
    overflow: hidden;
}

.journey-bar {
    height: 100%;
    min-width: 5px;

    background:
        linear-gradient(
            90deg,
            #555,
            #fff
        );

    transition: width .8s cubic-bezier(.2,.8,.2,1);
}

.journey-row:first-child .journey-bar {
    background: #fff;
}

.journey-count {
    text-align: right;
    font-size: 16px;
    letter-spacing: -.03em;
}

.journey-footer {
    margin-top: 18px;

    display: flex;
    justify-content: space-between;
    gap: 20px;

    color: var(--reports-dim);
    font-size: 8px;
    font-weight: 800;
    letter-spacing: .12em;
}

/* ============================================================
   ADVERTISING
   ============================================================ */

.ads-panel {
    min-height: 190px;

    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;

    padding: 35px;

    border: 1px solid var(--reports-border);
    background:
        radial-gradient(
            circle at 80% 50%,
            rgba(255,255,255,.045),
            transparent 35%
        ),
        #090909;
}

.ads-panel-brand {
    display: flex;
    align-items: center;
    gap: 16px;
}

.meta-mark {
    width: 52px;
    height: 52px;

    display: grid;
    place-items: center;

    border: 1px solid rgba(255,255,255,.16);
    background: #111;

    font-size: 22px;
    font-weight: 900;
}

.ads-panel-brand div:last-child {
    display: flex;
    flex-direction: column;
    gap: 5px;
}

.ads-panel-brand strong {
    font-size: 18px;
}

.ads-panel-brand span {
    color: var(--reports-muted);
    font-size: 11px;
}

.ads-coming {
    max-width: 450px;

    display: flex;
    align-items: center;
    gap: 15px;
}

.ads-lock {
    width: 42px;
    height: 42px;

    display: grid;
    place-items: center;

    border: 1px solid var(--reports-border);

    color: var(--reports-dim);
    font-size: 20px;
}

.ads-coming div {
    display: flex;
    flex-direction: column;
    gap: 5px;
}

.ads-coming strong {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: .08em;
}

.ads-coming small {
    color: var(--reports-muted);
    font-size: 11px;
    line-height: 1.6;
}

/* ============================================================
   FOOTER
   ============================================================ */

.reports-footer {
    width: min(1440px, calc(100% - 48px));
    margin: 0 auto;

    min-height: 110px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    color: #777;
}

.reports-footer > div {
    font-size: 11px;
    font-weight: 900;
    letter-spacing: .15em;
}

.reports-footer > div span {
    color: #333;
}

.reports-footer small {
    color: #444;
    font-size: 9px;
    letter-spacing: .08em;
}

/* ============================================================
   RESPONSIVE
   ============================================================ */

@media (max-width: 1100px) {

    .financial-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .live-metrics {
        grid-template-columns: repeat(2, 1fr);
    }

    .live-metric:nth-child(2) {
        border-right: 0;
    }

    .live-metric:nth-child(3) {
        border-top: 1px solid var(--reports-border);
    }

    .live-visual {
        border-top: 1px solid var(--reports-border);
    }
}

@media (max-width: 760px) {

    .reports-topbar,
    .reports-hero,
    .reports-section,
    .reports-live-panel,
    .reports-error,
    .reports-footer {
        width: min(100% - 28px, 1440px);
    }

    .reports-topbar {
        min-height: 70px;
    }

    .reports-topbar-actions {
        gap: 5px;
    }

    .reports-live-status {
        display: none;
    }

    .reports-back-button,
    .reports-refresh-button {
        padding: 0 10px;
        font-size: 10px;
    }

    .reports-hero {
        min-height: auto;
        padding: 70px 0 55px;
        display: block;
    }

    .reports-hero h1 {
        font-size: clamp(52px, 15vw, 90px);
    }

    .reports-hero h1 span {
        margin: 0 6px;
    }

    .reports-hero p {
        font-size: 13px;
    }

    .reports-hero-meta {
        margin-top: 45px;
        align-items: flex-start;
        text-align: left;
    }

    .section-heading,
    .live-panel-heading {
        align-items: flex-start;
        flex-direction: column;
    }

    .section-heading {
        margin-bottom: 28px;
    }

    .section-heading-note,
    .integration-status {
        align-self: flex-start;
    }

    .financial-grid {
        grid-template-columns: 1fr;
    }

    .financial-card {
        min-height: 200px;
    }

    .secondary-metrics {
        grid-template-columns: 1fr;
    }

    .secondary-metrics > div {
        border-right: 0;
        border-bottom: 1px solid var(--reports-border);
    }

    .secondary-metrics > div:last-child {
        border-bottom: 0;
    }

    .live-metrics {
        grid-template-columns: 1fr;
    }

    .live-metric,
    .live-visual {
        border-right: 0;
        border-bottom: 1px solid var(--reports-border);
    }

    .live-metric:last-of-type,
    .live-visual {
        border-bottom: 0;
    }

    .journey-row {
        grid-template-columns: 28px 1fr 55px;
        gap: 12px;
    }

    .journey-bar-track {
        grid-column: 2 / 3;
        grid-row: 2;
    }

    .journey-count {
        grid-column: 3;
        grid-row: 1 / span 2;
    }

    .journey-footer {
        flex-direction: column;
        gap: 8px;
    }

    .ads-panel {
        flex-direction: column;
        align-items: flex-start;
    }

    .ads-coming {
        width: 100%;
    }

    .reports-footer {
        min-height: 90px;
        flex-direction: column;
        align-items: flex-start;
        justify-content: center;
        gap: 8px;
    }
}

@media (max-width: 430px) {

    .reports-brand span {
        font-size: 11px;
    }

    .reports-brand small {
        font-size: 7px;
    }

    .reports-brand-mark {
        width: 36px;
        height: 36px;
    }

    .reports-back-button span {
        display: none;
    }

    .reports-hero h1 {
        font-size: 48px;
    }

    .live-metric strong {
        font-size: 38px;
    }

    .journey-row {
        padding: 12px;
    }
}
