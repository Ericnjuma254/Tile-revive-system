import React, { useMemo } from "react";

import {
    CircleMarker,
    MapContainer,
    Popup,
    TileLayer,
} from "react-leaflet";

import "leaflet/dist/leaflet.css";

const currency = (value) =>
    `KES ${Number(value || 0).toLocaleString()}`;

const number = (value) =>
    Number(value || 0).toLocaleString();

const KENYA_CENTER = [
    -0.0236,
    37.9062,
];

function getRadius(revenue, maxRevenue) {
    if (!maxRevenue || !revenue) return 8;

    return Math.max(
        8,
        Math.min(
            28,
            8 + (Number(revenue) / Number(maxRevenue)) * 20
        )
    );
}

function getOpacity(intensity) {
    return Math.max(
        0.35,
        Math.min(
            0.95,
            0.35 + (Number(intensity || 0) / 100) * 0.6
        )
    );
}

export default function GeographicAnalytics({
    geographicAnalytics,
}) {
    const analytics =
        geographicAnalytics || {};

    const summary =
        analytics.summary || {};

    const counties =
        Array.isArray(analytics.counties)
            ? analytics.counties
            : [];

    const topCounty =
        summary.topCounty || counties[0] || null;

    const maxRevenue = useMemo(
        () =>
            counties.reduce(
                (max, county) =>
                    Math.max(
                        max,
                        Number(county.revenue || 0)
                    ),
                0
            ),
        [counties]
    );

    return (
        <div className="geo-analytics">
            <div className="geo-summary-grid">

                <div className="geo-stat-card geo-stat-featured">
                    <span className="geo-stat-label">
                        TOP COUNTY
                    </span>

                    <strong>
                        {topCounty?.county || "—"}
                    </strong>

                    <small>
                        {topCounty
                            ? currency(topCounty.revenue)
                            : "No revenue data"}
                    </small>
                </div>

                <div className="geo-stat-card">
                    <span className="geo-stat-label">
                        ORDERS
                    </span>

                    <strong>
                        {number(summary.totalOrders)}
                    </strong>

                    <small>
                        {number(
                            summary.successfulOrders
                        )} successful
                    </small>
                </div>

                <div className="geo-stat-card">
                    <span className="geo-stat-label">
                        REVENUE
                    </span>

                    <strong>
                        {currency(
                            summary.totalRevenue
                        )}
                    </strong>

                    <small>
                        From successful orders
                    </small>
                </div>

                <div className="geo-stat-card">
                    <span className="geo-stat-label">
                        COUNTIES REACHED
                    </span>

                    <strong>
                        {number(
                            summary.countiesReached
                        )}
                    </strong>

                    <small>
                        {number(
                            summary.customers
                        )} customers
                    </small>
                </div>

            </div>

            <div className="geo-map-shell">

                <div className="geo-map-header">
                    <div>
                        <span className="section-eyebrow">
                            LIVE TERRITORY
                        </span>

                        <h3>
                            Customer geography
                        </h3>

                        <p>
                            Historical order concentration
                            across Kenya.
                        </p>
                    </div>

                    <div className="geo-coverage">
                        <span
                            className={
                                Number(
                                    summary.mappedOrders || 0
                                ) > 0
                                    ? "geo-status-dot active"
                                    : "geo-status-dot"
                            }
                        />

                        <div>
                            <strong>
                                {number(
                                    summary.mappedOrders
                                )} GPS mapped
                            </strong>

                            <small>
                                {Number(
                                    summary.mappingCoverage || 0
                                ).toFixed(1)}% coordinate coverage
                            </small>
                        </div>
                    </div>
                </div>

                <div className="geo-map-notice">
                    <span>◎</span>
                    <span>
                        County markers represent sales
                        concentration. Exact delivery pins
                        will appear automatically when future
                        orders contain GPS coordinates.
                    </span>
                </div>

                <div className="geo-map">
                    <MapContainer
                        center={KENYA_CENTER}
                        zoom={6}
                        minZoom={5}
                        maxZoom={11}
                        maxBounds={[
                            [-4.8, 33.5],
                            [5.2, 42.2],
                        ]}
                        maxBoundsViscosity={0.85}
                        scrollWheelZoom={true}
                        zoomControl={true}
                        style={{
                            width: "100%",
                            height: "620px",
                        }}
                    >

                        <div className="geo-map-overlay">
                            <div className="geo-map-live">
                                <span className="geo-live-dot" />
                                <span>ORDER TERRITORY</span>
                            </div>

                            <div className="geo-map-context">
                                <strong>
                                    Kenya
                                </strong>

                                <span>
                                    {number(summary.totalOrders)} historical orders analyzed
                                </span>
                            </div>
                        </div>

                        <div className="geo-map-legend">
                            <span className="geo-legend-title">
                                SALES INTENSITY
                            </span>

                            <div className="geo-legend-scale">
                                <span className="geo-legend-low" />
                                <span className="geo-legend-mid" />
                                <span className="geo-legend-high" />
                            </div>

                            <div className="geo-legend-labels">
                                <span>LOW</span>
                                <span>HIGH</span>
                            </div>
                        </div>

                        <TileLayer
                            attribution='&copy; OpenStreetMap contributors '
                            url="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
                        />

                        {counties
                            .filter(
                                county =>
                                    county.latitude !== null &&
                                    county.longitude !== null &&
                                    county.county !== "Unknown"
                            )
                            .map(county => (

                                <CircleMarker
                                    key={county.county}
                                    center={[
                                        Number(
                                            county.latitude
                                        ),
                                        Number(
                                            county.longitude
                                        ),
                                    ]}
                                    radius={getRadius(
                                        county.revenue,
                                        maxRevenue
                                    )}
                                    pathOptions={{
                                        color: "#32e875",
                                        weight: 1,
                                        fillColor: "#32e875",
                                        fillOpacity:
                                            getOpacity(
                                                county.intensity
                                            ),
                                    }}
                                >

                                    <Popup>
                                        <div className="geo-popup">

                                            <div className="geo-popup-title">
                                                {county.county}
                                            </div>

                                            <div className="geo-popup-revenue">
                                                {currency(
                                                    county.revenue
                                                )}
                                            </div>

                                            <div className="geo-popup-grid">

                                                <div>
                                                    <span>
                                                        ORDERS
                                                    </span>
                                                    <strong>
                                                        {number(
                                                            county.orders
                                                        )}
                                                    </strong>
                                                </div>

                                                <div>
                                                    <span>
                                                        SUCCESSFUL
                                                    </span>
                                                    <strong>
                                                        {number(
                                                            county.successfulOrders
                                                        )}
                                                    </strong>
                                                </div>

                                                <div>
                                                    <span>
                                                        CUSTOMERS
                                                    </span>
                                                    <strong>
                                                        {number(
                                                            county.customers
                                                        )}
                                                    </strong>
                                                </div>

                                                <div>
                                                    <span>
                                                        SHARE
                                                    </span>
                                                    <strong>
                                                        {Number(
                                                            county.intensity || 0
                                                        ).toFixed(0)}%
                                                    </strong>
                                                </div>

                                            </div>

                                        </div>
                                    </Popup>

                                </CircleMarker>

                            ))}

                    </MapContainer>
                </div>

            </div>

            <div className="geo-county-panel">

                <div className="geo-table-heading">
                    <div>
                        <span className="section-eyebrow">
                            COUNTY PERFORMANCE
                        </span>

                        <h3>
                            Where revenue is coming from
                        </h3>
                    </div>

                    <span className="geo-table-count">
                        {number(counties.length)} territories
                    </span>
                </div>

                <div className="geo-county-list">

                    {counties.length === 0 ? (
                        <div className="geo-empty">
                            No geographic order data available
                            for this period.
                        </div>
                    ) : (
                        counties.map(
                            (county, index) => (
                                <div
                                    className="geo-county-row"
                                    key={county.county}
                                >

                                    <div className="geo-rank">
                                        {String(
                                            index + 1
                                        ).padStart(2, "0")}
                                    </div>

                                    <div className="geo-county-name">
                                        <strong>
                                            {county.county}
                                        </strong>

                                        <span>
                                            {number(
                                                county.customers
                                            )} customers
                                        </span>
                                    </div>

                                    <div className="geo-bar-wrap">
                                        <div
                                            className="geo-bar"
                                            style={{
                                                width: `${Math.max(
                                                    3,
                                                    Number(
                                                        county.intensity || 0
                                                    )
                                                )}%`,
                                            }}
                                        />
                                    </div>

                                    <div className="geo-orders">
                                        <strong>
                                            {number(
                                                county.orders
                                            )}
                                        </strong>

                                        <span>
                                            orders
                                        </span>
                                    </div>

                                    <div className="geo-revenue">
                                        {currency(
                                            county.revenue
                                        )}
                                    </div>

                                </div>
                            )
                        )
                    )}

                </div>

            </div>

        </div>
    );
}




