:root {
    --reports-bg: #050505;
    --reports-surface: #0b0b0b;
    --reports-surface-2: #101010;
    --reports-surface-3: #151515;
    --reports-border: rgba(255,255,255,.09);
    --reports-border-strong: rgba(255,255,255,.18);
    --reports-white: #fff;
    --reports-text: #f4f4f4;
    --reports-muted: #8b8b8b;
    --reports-dim: #555;
    --reports-green: #32e875;
    --reports-red: #ff4d5a;
    --reports-radius: 18px;
}

.admin-reports,
.admin-reports * {
    box-sizing: border-box;
}

.admin-reports {
    min-height: 100vh;
    width: 100%;
    background:
        radial-gradient(
            circle at 80% 0%,
            rgba(255,255,255,.045),
            transparent 30%
        ),
        radial-gradient(
            circle at 10% 30%,
            rgba(255,255,255,.025),
            transparent 25%
        ),
        var(--reports-bg);
    color: var(--reports-text);
    font-family:
        Inter,
        ui-sans-serif,
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;
    overflow-x: hidden;
}

.admin-reports button {
    font: inherit;
}

.admin-reports button:focus-visible {
    outline: 2px solid var(--reports-green);
    outline-offset: 3px;
}

/* ============================================================
   LOADING
   ============================================================ */

.admin-reports-loading {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 22px;
    background: #050505;
    color: white;
}

.reports-loading-orbit {
    width: 64px;
    height: 64px;
    border: 1px solid rgba(255,255,255,.12);
    border-top-color: white;
    border-radius: 50%;
    animation: reportsSpin 1s linear infinite;
    position: relative;
}

.reports-loading-orbit span {
    position: absolute;
    width: 8px;
    height: 8px;
    background: var(--reports-green);
    border-radius: 50%;
    top: 5px;
    left: 50%;
    transform: translateX(-50%);
    box-shadow: 0 0 20px var(--reports-green);
}

.reports-loading-copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 5px;
}

.reports-loading-copy strong {
    font-size: 15px;
    letter-spacing: .08em;
}

.reports-loading-copy span {
    color: var(--reports-muted);
    font-size: 13px;
}

@keyframes reportsSpin {
    to {
        transform: rotate(360deg);
    }
}

/* ============================================================
   TOP BAR
   ============================================================ */

.reports-topbar {
    width: min(1440px, calc(100% - 48px));
    min-height: 84px;
    margin: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--reports-border);
}

.reports-brand {
    display: flex;
    align-items: center;
    gap: 13px;
}

.reports-brand-mark {
    width: 42px;
    height: 42px;
    display: grid;
    place-items: center;
    border: 1px solid rgba(255,255,255,.22);
    background: #111;
    font-size: 13px;
    font-weight: 900;
}

.reports-brand > div:last-child {
    display: flex;
    flex-direction: column;
    gap: 3px;
}

.reports-brand span {
    font-size: 13px;
    font-weight: 900;
    letter-spacing: .18em;
}

.reports-brand small {
    color: var(--reports-dim);
    font-size: 8px;
    font-weight: 800;
    letter-spacing: .18em;
}

.reports-topbar-actions {
    display: flex;
    align-items: center;
    gap: 9px;
}

.reports-live-status,
.reports-back-button,
.reports-refresh-button {
    height: 38px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0 13px;
    border: 1px solid var(--reports-border);
    background: #0d0d0d;
    color: #ddd;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: .08em;
    text-transform: uppercase;
}

.reports-live-status.live {
    color: var(--reports-green);
    border-color: rgba(50,232,117,.2);
    background: rgba(50,232,117,.06);
}

.reports-live-status.warning {
    color: var(--reports-red);
    border-color: rgba(255,77,90,.2);
    background: rgba(255,77,90,.05);
}

.reports-live-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: currentColor;
}

.reports-live-status.live .reports-live-dot {
    animation: livePulse 1.5s infinite;
}

.reports-live-status.warning .reports-live-dot {
    animation: redPulse 1.5s infinite;
}

@keyframes livePulse {
    0%,100% {
        opacity: 1;
        box-shadow: 0 0 0 3px rgba(50,232,117,.08);
    }
    50% {
        opacity: .45;
        box-shadow: 0 0 0 8px rgba(50,232,117,0);
    }
}

@keyframes redPulse {
    0%,100% {
        opacity: 1;
        box-shadow: 0 0 0 3px rgba(255,77,90,.08);
    }
    50% {
        opacity: .45;
        box-shadow: 0 0 0 8px rgba(255,77,90,0);
    }
}

.reports-back-button,
.reports-refresh-button {
    cursor: pointer;
    transition:
        background .2s ease,
        border-color .2s ease,
        transform .2s ease;
}

.reports-back-button:hover,
.reports-refresh-button:hover {
    background: #171717;
    border-color: var(--reports-border-strong);
    transform: translateY(-1px);
}

.reports-refresh-button:disabled {
    opacity: .55;
    cursor: wait;
}

.refresh-icon {
    font-size: 17px;
}

.refresh-icon.spinning {
    animation: reportsSpin .8s linear infinite;
}

/* ============================================================
   HERO
   ============================================================ */

.reports-hero {
    width: min(1440px, calc(100% - 48px));
    min-height: 350px;
    margin: auto;
    padding: 90px 0 70px;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    position: relative;
}

.reports-hero::before {
    content: "";
    position: absolute;
    left: -15%;
    right: -15%;
    bottom: 0;
    height: 1px;
    background: linear-gradient(
        90deg,
        transparent,
        rgba(255,255,255,.13),
        transparent
    );
}

.reports-hero-copy {
    max-width: 850px;
}

.reports-kicker {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 25px;
    color: var(--reports-muted);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: .18em;
}

.reports-kicker span {
    width: 28px;
    height: 1px;
    background: white;
}

.reports-hero h1 {
    margin: 0;
    font-size: clamp(55px, 8vw, 116px);
    line-height: .88;
    letter-spacing: -.075em;
    font-weight: 850;
}

.reports-hero h1 span {
    display: inline-block;
    margin: 0 14px;
    color: #444;
    font-weight: 300;
}

.reports-hero p {
    max-width: 620px;
    margin: 30px 0 0;
    color: var(--reports-muted);
    font-size: 15px;
    line-height: 1.8;
}

.reports-hero-meta {
    min-width: 180px;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 5px;
    text-align: right;
}

.hero-meta-line {
    width: 55px;
    height: 2px;
    margin-bottom: 8px;
    background: white;
}

.reports-hero-meta span {
    color: var(--reports-dim);
    font-size: 9px;
    font-weight: 800;
    letter-spacing: .16em;
}

.reports-hero-meta strong {
    font-size: 42px;
    line-height: 1;
    letter-spacing: -.06em;
}

.reports-hero-meta small {
    color: var(--reports-muted);
    font-size: 11px;
}

/* ============================================================
   NAVIGATION
   ============================================================ */

.reports-navigation {
    width: min(1440px, calc(100% - 48px));
    margin: 0 auto;
    padding: 45px 0 25px;
    border-bottom: 1px solid var(--reports-border);
}

.reports-nav-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 30px;
    margin-bottom: 18px;
}

.reports-nav-header > div:first-child {
    display: flex;
    flex-direction: column;
    gap: 5px;
}

.reports-nav-header span {
    color: var(--reports-dim);
    font-size: 9px;
    font-weight: 800;
    letter-spacing: .18em;
}

.reports-nav-header strong {
    font-size: 24px;
    letter-spacing: -.04em;
}

.period-selector {
    display: flex;
    border: 1px solid var(--reports-border);
    background: #090909;
}

.period-selector button {
    min-width: 55px;
    height: 36px;
    border: 0;
    border-right: 1px solid var(--reports-border);
    background: transparent;
    color: #666;
    cursor: pointer;
    font-size: 9px;
    font-weight: 900;
    letter-spacing: .1em;
}

.period-selector button:last-child {
    border-right: 0;
}

.period-selector button:hover {
    color: white;
    background: #151515;
}

.period-selector button.active {
    color: #050505;
    background: white;
}

.reports-dropdown {
    position: relative;
    z-index: 30;
}

.reports-dropdown-trigger {
    width: 100%;
    min-height: 78px;
    padding: 15px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border: 1px solid var(--reports-border);
    background:
        linear-gradient(
            135deg,
            rgba(255,255,255,.045),
            rgba(255,255,255,.012)
        );
    color: white;
    cursor: pointer;
    text-align: left;
}

.reports-dropdown-trigger:hover {
    border-color: var(--reports-border-strong);
    background: #101010;
}

.reports-dropdown-trigger > div {
    display: flex;
    flex-direction: column;
    gap: 5px;
}

.reports-dropdown-trigger span:first-child {
    color: var(--reports-dim);
    font-size: 8px;
    font-weight: 800;
    letter-spacing: .16em;
}

.reports-dropdown-trigger strong {
    font-size: 18px;
    letter-spacing: -.03em;
}

.dropdown-arrow {
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    border: 1px solid var(--reports-border);
    color: #aaa;
    transition: transform .2s ease;
}

.dropdown-arrow.open {
    transform: rotate(180deg);
}

.reports-dropdown-menu {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(100% + 6px);
    padding: 7px;
    border: 1px solid var(--reports-border-strong);
    background: #0b0b0b;
    box-shadow: 0 25px 70px rgba(0,0,0,.65);
}

.reports-dropdown-menu button {
    width: 100%;
    min-height: 65px;
    padding: 10px 13px;
    display: grid;
    grid-template-columns: 40px 1fr auto;
    align-items: center;
    gap: 12px;
    border: 1px solid transparent;
    background: transparent;
    color: white;
    text-align: left;
    cursor: pointer;
}

.reports-dropdown-menu button:hover {
    background: #151515;
    border-color: var(--reports-border);
}

.reports-dropdown-menu button.selected {
    background: rgba(50,232,117,.055);
    border-color: rgba(50,232,117,.18);
}

.reports-dropdown-menu button > span {
    color: #444;
    font-size: 10px;
    font-weight: 900;
}

.reports-dropdown-menu button > div {
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.reports-dropdown-menu button strong {
    font-size: 12px;
}

.reports-dropdown-menu button small {
    color: var(--reports-dim);
    font-size: 9px;
}

.reports-dropdown-menu button b {
    color: var(--reports-green);
}

/* ============================================================
   ERROR
   ============================================================ */

.reports-error {
    width: min(1440px, calc(100% - 48px));
    margin: 30px auto 0;
    padding: 16px 18px;
    display: flex;
    align-items: center;
    gap: 14px;
    border: 1px solid rgba(255,190,70,.2);
    background: rgba(255,190,70,.05);
}

.reports-error-icon {
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    border: 1px solid rgba(255,190,70,.3);
    color: #ffbd4a;
    font-weight: 800;
}

.reports-error-copy {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.reports-error-copy strong {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: .08em;
}

.reports-error-copy span {
    color: var(--reports-muted);
    font-size: 12px;
}

.reports-error button {
    border: 1px solid rgba(255,255,255,.14);
    background: #111;
    color: white;
    padding: 9px 13px;
    cursor: pointer;
}

/* ============================================================
   SECTIONS
   ============================================================ */

.reports-section,
.reports-live-panel {
    width: min(1440px, calc(100% - 48px));
    margin: auto;
}

.reports-section {
    padding: 80px 0;
    border-bottom: 1px solid var(--reports-border);
}

.section-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 30px;
    margin-bottom: 40px;
}

.section-index {
    display: block;
    margin-bottom: 12px;
    color: var(--reports-dim);
    font-size: 9px;
    font-weight: 800;
    letter-spacing: .18em;
}

.section-heading h2 {
    margin: 0;
    font-size: clamp(30px, 4vw, 50px);
    line-height: 1;
    letter-spacing: -.055em;
}

.section-heading p {
    max-width: 620px;
    margin: 13px 0 0;
    color: var(--reports-muted);
    font-size: 13px;
    line-height: 1.6;
}

.section-heading-note {
    padding: 8px 11px;
    border: 1px solid var(--reports-border);
    color: var(--reports-dim);
    font-size: 9px;
    font-weight: 800;
    letter-spacing: .12em;
}

/* ============================================================
   LIVE
   ============================================================ */

.reports-live-panel {
    padding: 70px 0;
    border-bottom: 1px solid var(--reports-border);
}

.live-panel-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 30px;
    margin-bottom: 35px;
}

.live-panel-heading h2 {
    margin: 0;
    font-size: clamp(28px, 4vw, 46px);
    letter-spacing: -.055em;
}

.live-panel-heading p {
    margin: 10px 0 0;
    color: var(--reports-muted);
    font-size: 13px;
}

.live-indicator {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 15px;
    border: 1px solid var(--reports-border);
    background: #0b0b0b;
}

.live-indicator-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--reports-dim);
}

.live-indicator.active {
    border-color: rgba(50,232,117,.2);
    background: rgba(50,232,117,.045);
}

.live-indicator.active .live-indicator-dot {
    background: var(--reports-green);
    animation: livePulse 1.4s infinite;
}

.live-indicator.inactive .live-indicator-dot {
    background: var(--reports-red);
    animation: redPulse 1.5s infinite;
}

.live-indicator div {
    display: flex;
    flex-direction: column;
    gap: 3px;
}

.live-indicator strong {
    font-size: 12px;
    text-transform: uppercase;
}

.live-indicator small {
    color: var(--reports-muted);
    font-size: 10px;
}

.live-metrics {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr 1.4fr;
    border: 1px solid var(--reports-border);
    background: var(--reports-surface);
}

.live-metric {
    min-height: 175px;
    padding: 27px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    border-right: 1px solid var(--reports-border);
}

.live-metric span {
    color: var(--reports-dim);
    font-size: 9px;
    font-weight: 800;
    letter-spacing: .14em;
}

.live-metric strong {
    margin-top: 13px;
    font-size: 45px;
    line-height: 1;
    letter-spacing: -.065em;
}

.live-metric small {
    margin-top: 8px;
    color: var(--reports-muted);
    font-size: 11px;
}

.live-metric.primary strong {
    color: var(--reports-green);
}

.live-visual {
    min-height: 175px;
    padding: 27px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 25px;
    background:
        linear-gradient(
            135deg,
            rgba(255,255,255,.035),
            transparent
        );
}

.live-wave {
    height: 65px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 5px;
}

.live-wave span {
    width: 100%;
    height: 20%;
    background: #333;
    animation: wave 1.8s ease-in-out infinite alternate;
}

.live-wave span:nth-child(2) { height: 45%; }
.live-wave span:nth-child(3) { height: 30%; }
.live-wave span:nth-child(4) { height: 70%; }
.live-wave span:nth-child(5) { height: 48%; }
.live-wave span:nth-child(6) { height: 90%; }
.live-wave span:nth-child(7) { height: 58%; }
.live-wave span:nth-child(8) { height: 78%; }
.live-wave span:nth-child(9) { height: 42%; }
.live-wave span:nth-child(10) { height: 68%; }
.live-wave span:nth-child(11) { height: 35%; }
.live-wave span:nth-child(12) { height: 55%; }

.live-wave span:nth-child(6),
.live-wave span:nth-child(8) {
    background: var(--reports-green);
    box-shadow: 0 0 18px rgba(50,232,117,.18);
}

@keyframes wave {
    from {
        opacity: .55;
        transform: scaleY(.82);
    }
    to {
        opacity: 1;
        transform: scaleY(1.06);
    }
}

.live-visual small {
    color: var(--reports-dim);
    font-size: 8px;
    font-weight: 800;
    letter-spacing: .16em;
}

/* ============================================================
   KPI CARDS
   ============================================================ */

.financial-grid,
.analytics-kpis {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
}

.financial-card {
    min-height: 210px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    background:
        linear-gradient(
            145deg,
            rgba(255,255,255,.045),
            rgba(255,255,255,.012)
        );
    border: 1px solid var(--reports-border);
    transition:
        transform .25s ease,
        border-color .25s ease,
        background .25s ease;
}

.financial-card:hover {
    transform: translateY(-4px);
    border-color: rgba(255,255,255,.18);
    background: #111;
}

.financial-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.financial-card-top span {
    color: var(--reports-muted);
    font-size: 9px;
    font-weight: 800;
    letter-spacing: .13em;
}

.financial-card-top i {
    width: 28px;
    height: 28px;
    display: grid;
    place-items: center;
    border: 1px solid var(--reports-border);
    color: #aaa;
    font-size: 10px;
    font-style: normal;
}

.financial-card > strong {
    margin-top: auto;
    font-size: clamp(28px, 3vw, 42px);
    line-height: 1;
    letter-spacing: -.06em;
}

.profit-card {
    border-color: rgba(50,232,117,.18);
    background:
        linear-gradient(
            145deg,
            rgba(50,232,117,.08),
            rgba(255,255,255,.015)
        );
}

.profit-card > strong {
    color: var(--reports-green);
}

.financial-card-bottom {
    margin-top: 16px;
    padding-top: 13px;
    border-top: 1px solid var(--reports-border);
    color: var(--reports-dim);
    font-size: 9px;
    font-weight: 800;
    letter-spacing: .1em;
}

/* ============================================================
   CHARTS
   ============================================================ */

.chart-grid {
    margin-top: 10px;
    display: grid;
    grid-template-columns: 1.7fr 1fr;
    gap: 10px;
}

.chart-card {
    min-height: 420px;
    padding: 24px;
    border: 1px solid var(--reports-border);
    background: #090909;
}

.chart-card.chart-large {
    min-height: 500px;
}

.chart-card-header {
    min-height: 55px;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
}

.chart-card-header > div {
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.chart-card-header span {
    color: var(--reports-muted);
    font-size: 9px;
    font-weight: 900;
    letter-spacing: .14em;
}

.chart-card-header small {
    color: var(--reports-dim);
    font-size: 10px;
}

.chart-card-header strong {
    margin-top: 4px;
    font-size: 30px;
    letter-spacing: -.05em;
}

.chart-live-label {
    color: var(--reports-green) !important;
}

.chart-area {
    height: 335px;
    margin-top: 20px;
}

.chart-large .chart-area {
    height: 405px;
}

.reports-tooltip {
    min-width: 150px;
    padding: 12px;
    border: 1px solid rgba(255,255,255,.13);
    background: rgba(8,8,8,.96);
    box-shadow: 0 20px 50px rgba(0,0,0,.5);
}

.reports-tooltip-label {
    display: block;
    margin-bottom: 8px;
    color: #777;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: .1em;
    text-transform: uppercase;
}

.reports-tooltip-row {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    padding: 4px 0;
    color: #aaa;
    font-size: 10px;
}

.reports-tooltip-row strong {
    color: white;
}

/* ============================================================
   JOURNEY
   ============================================================ */

.journey-card {
    min-height: 420px;
    padding: 30px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    border: 1px solid var(--reports-border);
    background:
        radial-gradient(
            circle at 50% 20%,
            rgba(50,232,117,.06),
            transparent 45%
        ),
        #090909;
}

.journey-card > span {
    color: var(--reports-dim);
    font-size: 9px;
    font-weight: 900;
    letter-spacing: .16em;
}

.journey-card > strong {
    margin-top: 25px;
    font-size: 70px;
    line-height: 1;
    letter-spacing: -.08em;
}

.journey-card > small {
    margin-top: 10px;
    color: var(--reports-muted);
}

.journey-progress {
    height: 8px;
    margin-top: 50px;
    overflow: hidden;
    background: #181818;
}

.journey-progress div {
    height: 100%;
    background: var(--reports-green);
    box-shadow: 0 0 20px rgba(50,232,117,.2);
}

.journey-stat {
    margin-top: 18px;
    padding-top: 15px;
    display: flex;
    justify-content: space-between;
    border-top: 1px solid var(--reports-border);
}

.journey-stat span {
    color: var(--reports-dim);
    font-size: 9px;
    font-weight: 800;
}

.journey-stat b {
    color: var(--reports-green);
}

/* ============================================================
   MARKETING
   ============================================================ */

.ads-panel {
    min-height: 190px;
    margin-bottom: 10px;
    padding: 35px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
    border: 1px solid var(--reports-border);
    background:
        radial-gradient(
            circle at 80% 50%,
            rgba(255,255,255,.045),
            transparent 35%
        ),
        #090909;
}

.ads-panel-brand {
    display: flex;
    align-items: center;
    gap: 16px;
}

.meta-mark {
    width: 52px;
    height: 52px;
    display: grid;
    place-items: center;
    border: 1px solid rgba(255,255,255,.16);
    background: #111;
    font-size: 22px;
    font-weight: 900;
}

.ads-panel-brand div:last-child,
.ads-coming div:last-child {
    display: flex;
    flex-direction: column;
    gap: 5px;
}

.ads-panel-brand strong {
    font-size: 18px;
}

.ads-panel-brand span {
    color: var(--reports-muted);
    font-size: 11px;
}

.ads-coming {
    max-width: 500px;
    display: flex;
    align-items: center;
    gap: 15px;
}

.ads-lock {
    width: 42px;
    height: 42px;
    display: grid;
    place-items: center;
    border: 1px solid var(--reports-border);
    color: var(--reports-dim);
}

.ads-coming strong {
    font-size: 12px;
    text-transform: uppercase;
}

.ads-coming small {
    color: var(--reports-muted);
    font-size: 11px;
    line-height: 1.6;
}

/* ============================================================
   EMPTY
   ============================================================ */

.empty-chart {
    height: 100%;
    min-height: 260px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 8px;
}

.empty-chart-icon {
    width: 55px;
    height: 55px;
    display: grid;
    place-items: center;
    margin-bottom: 10px;
    border: 1px solid var(--reports-border);
    color: #555;
    font-size: 24px;
}

.empty-chart strong {
    font-size: 13px;
}

.empty-chart span {
    max-width: 300px;
    color: var(--reports-dim);
    font-size: 11px;
    line-height: 1.6;
}

/* ============================================================
   FOOTER
   ============================================================ */

.reports-footer {
    width: min(1440px, calc(100% - 48px));
    min-height: 110px;
    margin: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: #777;
}

.reports-footer > div {
    font-size: 11px;
    font-weight: 900;
    letter-spacing: .15em;
}

.reports-footer > div span {
    color: #333;
}

.reports-footer small {
    color: #444;
    font-size: 9px;
    letter-spacing: .08em;
}

/* ============================================================
   RESPONSIVE
   ============================================================ */

@media (max-width: 1100px) {

    .financial-grid,
    .analytics-kpis {
        grid-template-columns: repeat(2, 1fr);
    }

    .live-metrics {
        grid-template-columns: repeat(2, 1fr);
    }

    .live-metric:nth-child(2) {
        border-right: 0;
    }

    .live-metric:nth-child(3),
    .live-visual {
        border-top: 1px solid var(--reports-border);
    }

    .chart-grid {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 760px) {

    .reports-topbar,
    .reports-hero,
    .reports-navigation,
    .reports-section,
    .reports-live-panel,
    .reports-error,
    .reports-footer {
        width: calc(100% - 28px);
    }

    .reports-topbar {
        min-height: 70px;
    }

    .reports-live-status {
        display: none;
    }

    .reports-back-button,
    .reports-refresh-button {
        padding: 0 10px;
        font-size: 9px;
    }

    .reports-hero {
        min-height: auto;
        padding: 70px 0 55px;
        display: block;
    }

    .reports-hero h1 {
        font-size: clamp(50px, 15vw, 90px);
    }

    .reports-hero p {
        font-size: 13px;
    }

    .reports-hero-meta {
        margin-top: 45px;
        align-items: flex-start;
        text-align: left;
    }

    .reports-nav-header,
    .section-heading,
    .live-panel-heading,
    .ads-panel {
        align-items: flex-start;
        flex-direction: column;
    }

    .period-selector {
        width: 100%;
    }

    .period-selector button {
        flex: 1;
    }

    .financial-grid,
    .analytics-kpis {
        grid-template-columns: 1fr;
    }

    .live-metrics {
        grid-template-columns: 1fr;
    }

    .live-metric,
    .live-visual {
        border-right: 0;
        border-bottom: 1px solid var(--reports-border);
    }

    .live-visual {
        border-bottom: 0;
    }

    .chart-card,
    .chart-card.chart-large {
        min-height: 350px;
    }

    .chart-area,
    .chart-large .chart-area {
        height: 270px;
    }

    .ads-coming {
        width: 100%;
    }

    .reports-footer {
        min-height: 90px;
        flex-direction: column;
        align-items: flex-start;
        justify-content: center;
        gap: 8px;
    }
}

@media (max-width: 430px) {

    .reports-brand span {
        font-size: 11px;
    }

    .reports-brand small {
        font-size: 7px;
    }

    .reports-brand-mark {
        width: 36px;
        height: 36px;
    }

    .reports-back-button {
        display: none;
    }

    .reports-hero h1 {
        font-size: 48px;
    }

    .live-metric strong {
        font-size: 38px;
    }

    .reports-dropdown-menu button {
        grid-template-columns: 30px 1fr auto;
    }
}

/* ============================================================
   GEOGRAPHIC ANALYTICS — PREMIUM KENYA MAP
   ============================================================ */

.geo-map {
    position: relative;
    overflow: hidden;
    min-height: 620px;
    background: #050505;
    border: 1px solid var(--reports-border);
    border-radius: var(--reports-radius);
}

.geo-map .leaflet-container {
    width: 100%;
    height: 620px !important;
    min-height: 620px;
    background: #050505;
    font-family: inherit;
}

.geo-map .leaflet-tile {
    filter:
        brightness(0.72)
        contrast(1.12)
        saturate(0.65);
}

.geo-map .leaflet-control-zoom {
    border: 1px solid rgba(255,255,255,0.12) !important;
    box-shadow: 0 10px 30px rgba(0,0,0,0.45) !important;
}

.geo-map .leaflet-control-zoom a {
    width: 34px !important;
    height: 34px !important;
    line-height: 34px !important;
    background: rgba(8,8,8,0.92) !important;
    color: #fff !important;
    border-color: rgba(255,255,255,0.08) !important;
}

.geo-map .leaflet-control-zoom a:hover {
    background: #151515 !important;
}

.geo-map .leaflet-control-attribution {
    background: rgba(0,0,0,0.72) !important;
    color: rgba(255,255,255,0.45) !important;
    font-size: 9px;
}

.geo-map .leaflet-control-attribution a {
    color: rgba(255,255,255,0.7) !important;
}

/* Map overlays */

.geo-map-overlay {
    position: absolute;
    z-index: 500;
    top: 20px;
    left: 20px;
    min-width: 230px;
    padding: 14px 16px;
    background: rgba(5,5,5,0.88);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 12px;
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    box-shadow: 0 18px 45px rgba(0,0,0,0.45);
    pointer-events: none;
}

.geo-map-live {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 10px;
    color: rgba(255,255,255,0.5);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.18em;
}

.geo-live-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--reports-green);
    box-shadow: 0 0 12px var(--reports-green);
    animation: geo-pulse 1.8s infinite;
}

.geo-map-context {
    display: flex;
    flex-direction: column;
    gap: 3px;
}

.geo-map-context strong {
    color: #fff;
    font-size: 20px;
    letter-spacing: -0.02em;
}

.geo-map-context span {
    color: rgba(255,255,255,0.48);
    font-size: 11px;
}

/* Legend */

.geo-map-legend {
    position: absolute;
    z-index: 500;
    right: 20px;
    bottom: 28px;
    width: 150px;
    padding: 13px 14px;
    background: rgba(5,5,5,0.9);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 10px;
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    pointer-events: none;
}

.geo-legend-title {
    display: block;
    margin-bottom: 9px;
    color: rgba(255,255,255,0.52);
    font-size: 8px;
    font-weight: 800;
    letter-spacing: 0.15em;
}

.geo-legend-scale {
    display: flex;
    height: 6px;
    overflow: hidden;
    border-radius: 999px;
}

.geo-legend-low,
.geo-legend-mid,
.geo-legend-high {
    flex: 1;
}

.geo-legend-low {
    background: rgba(50,232,117,0.18);
}

.geo-legend-mid {
    background: rgba(50,232,117,0.5);
}

.geo-legend-high {
    background: rgba(50,232,117,0.95);
}

.geo-legend-labels {
    display: flex;
    justify-content: space-between;
    margin-top: 6px;
    color: rgba(255,255,255,0.35);
    font-size: 7px;
    font-weight: 700;
    letter-spacing: 0.1em;
}

/* County marker interaction */

.geo-map .leaflet-interactive {
    transition:
        opacity 180ms ease,
        stroke-width 180ms ease;
}

.geo-map .leaflet-interactive:hover {
    stroke-width: 3;
    filter:
        drop-shadow(0 0 8px rgba(50,232,117,0.75))
        drop-shadow(0 0 18px rgba(50,232,117,0.35));
}

/* Popup */

.geo-map .leaflet-popup-content-wrapper,
.geo-map .leaflet-popup-tip {
    background: #0b0b0b;
    color: #fff;
    border: 1px solid rgba(255,255,255,0.1);
}

.geo-map .leaflet-popup-content-wrapper {
    border-radius: 12px;
    box-shadow: 0 20px 55px rgba(0,0,0,0.6);
}

.geo-map .leaflet-popup-close-button {
    color: rgba(255,255,255,0.45) !important;
}

.geo-popup {
    min-width: 210px;
    padding: 4px;
}

.geo-popup-title {
    margin-bottom: 4px;
    color: rgba(255,255,255,0.5);
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
}

.geo-popup-revenue {
    margin-bottom: 14px;
    color: #fff;
    font-size: 22px;
    font-weight: 800;
    letter-spacing: -0.03em;
}

.geo-popup-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 8px;
}

.geo-popup-grid > div {
    padding: 9px;
    background: rgba(255,255,255,0.045);
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: 7px;
}

.geo-popup-grid span {
    display: block;
    margin-bottom: 4px;
    color: rgba(255,255,255,0.38);
    font-size: 7px;
    font-weight: 800;
    letter-spacing: 0.12em;
}

.geo-popup-grid strong {
    color: #fff;
    font-size: 12px;
}

/* Mobile */

@media (max-width: 768px) {
    .geo-map {
        min-height: 480px;
    }

    .geo-map-overlay {
        top: 12px;
        left: 12px;
    }

    .geo-map-legend {
        right: 12px;
        bottom: 20px;
    }
}


