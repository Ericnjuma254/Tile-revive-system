// ============================================================
// HELPERS
// ============================================================

const currency = (value) =>
    `KES ${Number(value || 0).toLocaleString()}`;

const number = (value) =>
    Number(value || 0).toLocaleString();

const percent = (value) =>
    `${Number(value || 0).toFixed(1)}%`;


// ============================================================
// SAFE DATA NORMALIZER
// ============================================================

function normalizeReports(raw) {

    const data = raw || {};

    const financial =
        data.financial ||
        data.finance ||
        {};

    const sales =
        data.sales ||
        {};

    const customers =
        data.customers ||
        data.customer ||
        {};

    const products =
        data.products ||
        {};

    const marketing =
        data.marketing ||
        {};

    const overview =
        data.overview ||
        {};

    const revenue =
        financial.revenue ??
        sales.revenue ??
        overview.revenue ??
        data.revenue ??
        0;

    const expenditure =
        financial.expenditure ??
        financial.expenses ??
        overview.expenditure ??
        data.expenditure ??
        0;

    const profit =
        financial.profit ??
        financial.netProfit ??
        Number(revenue) - Number(expenditure);

    const orders =
        sales.orders ??
        overview.orders ??
        data.orders ??
        0;

    const customersCount =
        customers.total ??
        customers.totalCustomers ??
        overview.customers ??
        data.customersCount ??
        0;

    const activeCustomers =
        customers.active ??
        customers.activeCustomers ??
        data.activeCustomers ??
        0;

    const visitors =
        customers.visitors ??
        marketing.visitors ??
        data.visitors ??
        0;

    const conversion =
        customers.conversionRate ??
        sales.conversionRate ??
        overview.conversionRate ??
        0;

    const salesTrend =
        sales.trend ||
        sales.daily ||
        data.salesTrend ||
        data.revenueTrend ||
        [];

    const customerTrend =
        customers.trend ||
        customers.daily ||
        data.customerTrend ||
        [];

    const productPerformance =
        products.performance ||
        products.topProducts ||
        products.bestSelling ||
        data.productPerformance ||
        [];

    const trafficSources =
        marketing.sources ||
        marketing.trafficSources ||
        data.trafficSources ||
        [];

    const paymentMethods =
        financial.paymentMethods ||
        sales.paymentMethods ||
        data.paymentMethods ||
        [];

    return {
        raw: data,
        revenue,
        expenditure,
        profit,
        orders,
        customersCount,
        activeCustomers,
        visitors,
        conversion,
        salesTrend,
        customerTrend,
        productPerformance,
        trafficSources,
        paymentMethods,
    };
}


// ============================================================
// TOOLTIP
// ============================================================

function ChartTooltip({ active, payload, label }) {

    if (!active || !payload?.length) {
        return null;
    }

    return (
        <div className="reports-tooltip">

            <span className="reports-tooltip-label">
                {label}
            </span>

            {payload.map((item, index) => (
                <div
                    className="reports-tooltip-row"
                    key={`${item.name}-${index}`}
                >
                    <span>
                        {item.name}
                    </span>

                    <strong>
                        {typeof item.value === "number"
                            ? number(item.value)
                            : item.value}
                    </strong>
                </div>
            ))}

        </div>
    );
}


// ============================================================
